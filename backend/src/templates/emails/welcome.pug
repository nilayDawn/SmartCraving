doctype html
html
  head
    title Welcome to SmartCraving
    style.
      a {
        text-decoration: none;
        color: #2563eb;
      }
      a.cta-button {
        display: inline-block;
        color: white;
        width: 15rem;
        height: 3rem;
        line-height: 3rem;
        text-align: center;
        background-color: rgb(190,82,31);
        border-radius: 1em;
      }
  body
    p Hi #{firstName},
    p Welcome to SmartCraving! We're thrilled to have you join our food discovery and ordering community.
    p Explore your favorite local restaurants, curated menus, and chef specials today.
    a.cta-button(href=url, target='_blank', rel='noopener') START EXPLORING
