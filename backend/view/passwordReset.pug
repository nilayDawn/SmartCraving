doctype html
html
  head
    title Password Reset
    style.
      a{
      text-decoration: none;
      color: #2563eb;
      }
      a.reset-button{
      display: inline-block;
      color: white;
      width: 15rem;
      height: 3rem;
      line-height: 3rem;
      text-align: center;
      background-color: rgb(190,82,31);
      border-radius: 1em;
      }
  body
    p Hi #{firstName},
    p
      | Forgot your password? Click the button below to choose a new password.
    a.reset-button(href=url, target='_blank', rel='noopener') RESET YOUR PASSWORD
    p If you didn&apos;t forget your password, please ignore this email!
